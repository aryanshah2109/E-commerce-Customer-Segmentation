# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Local tooling and environments
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.docx/
.docx_packages/
docs/

# Secrets and runtime files
.env
.streamlit/secrets.toml
logs/
*.log

# Data: keep only the feature tables the dashboard reads.
# raw.csv, interim data and splits are regenerable and stay out of Git.
/data/*
!/data/processed/
/data/processed/*
!/data/processed/customer_features/
!/data/processed/sales_features/

# Models: keep only the promoted inference bundle
/models/*
!/models/segmentation/
/models/segmentation/*
!/models/segmentation/best_model/

# Artifacts: keep only the JSON/CSV reports the API and dashboard read
/artifacts/*
!/artifacts/reports/