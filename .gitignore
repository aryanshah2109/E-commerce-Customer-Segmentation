# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments and local tooling
.venv/
.docx/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Local runtime files
logs/
*.log

# Environment files
.env

# Raw/generated data stays out of Git because it can be large.
data/

# Keep the promoted inference bundle in Git for API deployment.
# Candidate models remain ignored; only the production bundle is versioned.
models/*
!models/segmentation/
models/segmentation/*
!models/segmentation/best_model/
!models/segmentation/best_model/**

# Reports and artifacts are intentionally not ignored because the API and
# dashboard read the generated deployment reports from this directory.

# Source package named data is code, not generated data
!src/customer_sales_analytics/data/
!src/customer_sales_analytics/data/**/*.py

# docx and packages
.docx_packages/
docs/
